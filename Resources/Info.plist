<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>OTP Snatcher</string>
	<key>CFBundleDisplayName</key>
	<string>OTP Snatcher</string>
	<key>CFBundleExecutable</key>
	<string>OTPSnatcher</string>
	<!-- Chosen once and never changed. TCC keys the Full Disk Access grant to
	     the signature and identifier, and Control Center tracks menu-bar items
	     by bundle id, so renaming this orphans both. -->
	<key>CFBundleIdentifier</key>
	<string>com.pooya.otpsnatcher</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- Menu bar only: no Dock icon, no window on launch. -->
	<key>LSUIElement</key>
	<true/>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>NSHumanReadableCopyright</key>
	<string>No network access. No analytics. Reads the local Messages database only.</string>
</dict>
</plist>
